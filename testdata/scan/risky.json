{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_aBcDeFgHiJkLmNoPqRsTuVwXyZ0123456789" }
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2025.8.21", "/"]
    },
    "pinned-safe": {
      "command": "/Users/me/.local/bin/roro",
      "args": ["--config", "/Users/me/.roro/roro.yaml", "wrap", "--agent", "claude-desktop", "--server", "pinned-safe", "--", "uvx", "mcp-server-fetch==2025.4.7"],
      "env": { "API_TOKEN": "${API_TOKEN}" }
    },
    "docs": { "url": "http://docs.example.com/mcp", "headers": { "Authorization": "Bearer abcdef0123456789abcdef" } },
    "box": { "command": "docker", "args": ["run", "-i", "--rm", "--privileged", "-v", "/var/run/docker.sock:/var/run/docker.sock", "ghcr.io/acme/mcp"] }
  }
}
