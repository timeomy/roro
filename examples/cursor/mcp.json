{
  "mcpServers": {
    "filesystem-via-roro": {
      "command": "/usr/local/bin/roro",
      "args": [
        "--config", "/Users/me/roro/roro.yaml",
        "wrap", "--agent", "cursor", "--client", "cursor",
        "--", "npx", "-y", "@modelcontextprotocol/server-filesystem", "/Users/me/roro/sandbox"
      ]
    }
  }
}
